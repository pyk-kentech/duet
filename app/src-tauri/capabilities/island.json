{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "island",
  "description": "섬 창(엔진 화면 #/island)에만: 앱 명령 island_mode·open_main 을 부를 수 있다. 다른 Tauri 권한은 주지 않는다.",
  "windows": [
    "island"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-island-mode",
    "allow-open-main"
  ]
}
