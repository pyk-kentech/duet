{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tenure",
  "version": "0.1.0",
  "identifier": "dev.tenure.desktop",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tenure",
        "width": 1320,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "engine/": "engine/"
    },
    "publisher": "tenure",
    "shortDescription": "Claude Code·Codex 를 함께 부리는 로컬 앱",
    "longDescription": "구독 CLI(Claude Code·Codex)로 과제를 구현·리뷰하고, 작업마다 worktree·병합·대화형 터미널을 다루는 로컬 앱",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxQ0EzMTQ1NDczQjJDNzkKUldSNUxEdEhSVEhLQVhzR2ZyYmtIN3MzUlhCZWtBVTVWOHBBSi95aXpnOFhvNy9kYnIxSXJrZUwK",
      "endpoints": [
        "https://github.com/pyk-kentech/duet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
