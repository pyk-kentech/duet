#!/usr/bin/env python3
"""가짜 Codex CLI. `codex exec [flags] -o <file> [prompt|-]` 흉내."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _fake_common as fc  # noqa: E402

argv = sys.argv[1:]
if argv == ["--version"]:
    print("codex-cli 0.0.0-fake")
    sys.exit(0)

stdin_text = fc.read_stdin_if_piped()
fc.dump(argv, stdin_text)
fc.handle_common_failures()

out_path = None
for flag in ("-o", "--output-last-message"):
    if flag in argv:
        out_path = argv[argv.index(flag) + 1]

prompt = argv[-1] if argv else ""
if prompt == "-":
    prompt = stdin_text or ""

s = fc.scenario()
sys.stdout.write("[fake codex] working...\n")
if s == "empty":
    # last-message 파일을 비워 두고 stdout만 남김
    sys.stdout.write("stdout fallback text\n")
    sys.exit(0)
if s == "garbage":
    sys.exit(0)
if out_path:
    with open(out_path, "w", encoding="utf-8") as f:
        f.write(fc.text() + "\n")
sys.stdout.write("[fake codex] prompt_len=%d\n" % len(prompt))
