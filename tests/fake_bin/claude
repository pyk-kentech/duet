#!/usr/bin/env python3
"""가짜 Claude Code CLI. `claude -p --output-format json [flags] [prompt]` 흉내."""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _fake_common as fc  # noqa: E402

argv = sys.argv[1:]
if argv == ["--version"]:
    print("9.9.9 (Fake Claude Code)")
    sys.exit(0)
if argv[:2] == ["auth", "login"]:
    print("Browser didn't open? Use the url below to sign in:")
    print("https://claude.ai/oauth/authorize?code=true&state=FAKE")
    sys.stdout.write("Paste code here if prompted > ")
    sys.stdout.flush()
    code = sys.stdin.readline().strip()
    print("Login successful." if code else "No code.")
    sys.exit(0 if code else 1)
if argv[:2] == ["auth", "status"]:
    logged = os.environ.get("DUET_FAKE_LOGGED", "1") == "1"
    print(json.dumps({"loggedIn": logged, "authMethod": "claude.ai" if logged else "none",
                      "subscriptionType": "max" if logged else None}))
    sys.exit(0 if logged else 1)

stdin_text = fc.read_stdin_if_piped()
fc.dump(argv, stdin_text)
fc.handle_common_failures()
if fc.scenario() == "fail_resume" and "--resume" in argv:
    sys.stderr.write("fake: No conversation found with session ID\n")
    sys.exit(1)

s = fc.scenario()
if s == "garbage":
    sys.stdout.write("this is not json\n")
    sys.exit(0)
if s == "empty":
    sys.exit(0)
if s == "json_error":
    print(json.dumps({"type": "result", "subtype": "success", "is_error": True,
                      "api_error_status": 401, "result": "Invalid API key · Fix external API key"}))
    sys.exit(0)

# 실제 claude(commander)처럼 파싱: 값 하나짜리 옵션, 가변 인자 옵션(<tools...>: 다음 옵션이나 `--` 전까지 삼킴),
# `--` 뒤는 전부 위치 인자. 위치 인자가 없고 stdin 도 없으면 실제와 같은 에러.
VALUE_FLAGS = {"--output-format", "--permission-mode", "--model", "--effort", "--json-schema", "--resume",
               "--session-id"}
VARIADIC_FLAGS = {"--allowedTools", "--allowed-tools", "--disallowedTools", "--disallowed-tools", "--tools"}
positional = []
i = 0
while i < len(argv):
    a = argv[i]
    if a == "--":
        positional.extend(argv[i + 1:])
        break
    if a in VALUE_FLAGS:
        i += 2
        continue
    if a in VARIADIC_FLAGS:
        i += 1
        while i < len(argv) and not argv[i].startswith("-"):
            i += 1
        continue
    if a.startswith("-"):
        i += 1
        continue
    positional.append(a)
    i += 1
if positional:
    prompt = positional[0]
elif stdin_text:
    prompt = stdin_text
else:
    sys.stderr.write("Error: Input must be provided either through stdin or as a prompt argument when using --print\n")
    sys.exit(1)

out = {
    "type": "result",
    "subtype": "success",
    "is_error": False,
    "result": fc.text(),
    "prompt_len": len(prompt),
    "usage": {"input_tokens": 10, "cache_creation_input_tokens": 100, "cache_read_input_tokens": 1000,
              "output_tokens": 50, "output_tokens_details": {"thinking_tokens": 7}},
    "total_cost_usd": 0.0123,
    "modelUsage": {"claude-opus-5-5": {}},
    "session_id": argv[argv.index("--resume") + 1] if "--resume" in argv else os.environ.get("DUET_FAKE_SESSION", "fake-session-new"),
}
if "--json-schema" in argv and os.environ.get("DUET_FAKE_STRUCTURED"):
    out["structured_output"] = json.loads(os.environ["DUET_FAKE_STRUCTURED"])
print(json.dumps(out, ensure_ascii=False))
